# Пример окружения. Скопируй в .env рядом с каталогом models/ и заполни значения.

# --- ключи из keys.toml -------------------------------------------------------
GROQ_API_KEY=
GROQ_API_KEY_2=
OPENROUTER_API_KEY=

# --- роли и пределы хода ------------------------------------------------------
# Роль ссылается на цепочку по имени из chains.toml.
PERSONA_MODELCHAIN = "persona"

# Пределы одного хода целиком, на все модели цепочки: время (сек) и число попыток.
# 0 или пусто — без предела.
LLM_TURN_DEADLINE = 150
LLM_TURN_MAX_ATTEMPTS = 8
